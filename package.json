{
  "name": "wp-support-rag",
  "version": "1.0.0",
  "description": "Grounded WordPress support copilot: hybrid RAG with Claude, plus retrieval and answer evals",
  "scripts": {
    "fetch": "tsx scripts/fetch-docs.ts",
    "index": "tsx scripts/build-index.ts",
    "setup": "npm run fetch && npm run index",
    "ask": "node --env-file-if-exists=.env --import tsx src/ask.ts",
    "eval:retrieval": "tsx evals/retrieval.ts",
    "eval:judge-check": "node --env-file-if-exists=.env --import tsx evals/judge-check.ts",
    "eval:answers": "node --env-file-if-exists=.env --import tsx evals/answers.ts",
    "typecheck": "tsc -p ."
  },
  "keywords": [],
  "author": "",
  "license": "MIT",
  "type": "module",
  "dependencies": {
    "@anthropic-ai/sdk": "^1.3.0",
    "@huggingface/transformers": "^4.3.2",
    "html-to-text": "^10.0.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/html-to-text": "^9.0.4",
    "@types/node": "^26.6.5",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  }
}
